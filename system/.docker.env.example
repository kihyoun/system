#-------------------------------------------------------------
# Filepath: ./.docker.env

# -- SEED
export SEED_DIR=/mnt/seed

# -- GITLAB
# Optional first-install password (12+ characters). Empty generates a unique one.
# Set a real value only in the private .docker.env, never in this tracked example.
GITLAB_INITIAL_ROOT_PASSWORD=
GITLAB_EXTERNAL_URL=https://gitlab.example.com
GITLAB_REGISTRY_URL=https://registry.example.com

# -- NGINX
export GITLAB_HOST=gitlab.example.com
GITLAB_DOMAIN_MODE=0

GITLAB_SSL=/live/gitlab.example.com/fullchain.pem
GITLAB_SSL_KEY=/live/gitlab.example.com/privkey.pem

export GITLAB_REGISTRY_HOST=registry.example.com
GITLAB_REGISTRY_DOMAIN_MODE=0

GITLAB_REGISTRY_SSL=/live/gitlab.example.com/fullchain.pem
GITLAB_REGISTRY_SSL_KEY=/live/gitlab.example.com/privkey.pem

export GITLAB_IMAGE='gitlab/gitlab-ce:19.5.3-ce.0@sha256:6863d156a1a477bd6f69fc674b671d0163cd8b06bf63bb17cc4a4a803b78b27c'

# -- GITLAB RUNNER
export GITLAB_RUNNER_IMAGE='gitlab/gitlab-runner:v19.5.1@sha256:8e049fb719162488893a9eccc48f3a05259d02f2386dfbb20f3e379a50575afd'
GITLAB_RUNNER_TOKEN=secret-token
export GITLAB_RUNNER_SCALE=4

# --- Sync Settings
export SYNC_ENABLE=true

export SYNC_HOST=sync.example.com
export SYNC_USER=admin
export SYNC_PASS=admin
export SYNC_DOMAIN_MODE=0

export SYNC_SSL=/live/sync.example.com/fullchain.pem
export SYNC_SSL_KEY=/live/sync.example.com/privkey.pem

# --- Wizard Settings
export WIZARD_ENABLE=true

export WIZARD_HOST=wizard.example.com
export WIZARD_DOMAIN_MODE=0

export WIZARD_SSL=/live/wizard.example.com/fullchain.pem
export WIZARD_SSL_KEY=/live/wizard.example.com/privkey.pem

# Optional exact alias DNS names; see docs/WIZARD_ALIASES.md before enabling.
export WIZARD_ALIASES=""
# Alias HTTPS reuses WIZARD_SSL/WIZARD_SSL_KEY by default. Certificates must
# cover every alias. Override both paths together when using another certificate:
# export WIZARD_ALIAS_SSL=/ssl/live/aliases.example.com/fullchain.pem
# export WIZARD_ALIAS_SSL_KEY=/ssl/live/aliases.example.com/privkey.pem

# Public website details: replace these examples in General > Website.
# These six fields are intentionally visible without a Sync login.
export WIZARD_OPERATOR_NAME="Max Mustermann"
export WIZARD_OPERATOR_ADDRESS="Musterstraße 1
12345 Musterstadt
Deutschland"
export WIZARD_OPERATOR_EMAIL="kontakt@example.com"
export WIZARD_PRIVACY_NOTICE_URL=""
export WIZARD_ACCESS_LOG_RETENTION=""
export WIZARD_PRIVACY_TEXT=""

