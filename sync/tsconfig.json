{
    "compilerOptions": {
        "module": "node20",
        "esModuleInterop": true,
        "target": "es2022",
        "noImplicitAny": true,
        "strict": false,
        "moduleResolution": "node16",
        "types": [
            "node"
        ],
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "src",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "include": [
        "src/**/*"
    ]
}
