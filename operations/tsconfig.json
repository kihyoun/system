{
  "compilerOptions": {
    "module": "node20",
    "esModuleInterop": true,
    "target": "es2022",
    "noImplicitAny": true,
    "strict": true,
    "moduleResolution": "node16",
    "types": [
      "node"
    ],
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true
  },
  "include": [
    "src/**/*"
  ]
}
