{
  "name": "@systembootstrapper/cli",
  "version": "2.0.0",
  "description": "Shared System Bootstrapper operations runtime",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/package-assets.cjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --config ../.prettierrc --ignore-path ../.prettierignore --check \"src/**/*.{ts,tsx,js,jsx}\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "^24.22.0",
    "npm": "^11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  },
  "types": "dist/index.d.ts",
  "private": false,
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "system-bootstrapper": "dist/cli.js"
  },
  "bundleDependencies": [
    "@nestjs/common",
    "@nestjs/core",
    "reflect-metadata",
    "rxjs"
  ]
}
